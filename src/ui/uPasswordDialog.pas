unit uPasswordDialog;

{$mode objfpc}{$H+}

// Outils de mot de passe d'une entree: verification locale contre les valeurs lisibles, test
// de bind sur une connexion a part, calcul et ecriture (userPassword, Password Modify RFC 3062,
// unicodePwd sur AD). Une tentative par clic, aucun essai en serie, aucune conversion
// d'empreinte: ce n'est pas un outil de brute force et ca ne le deviendra pas.

interface

uses
  Classes, SysUtils, Forms, Controls, Graphics, StdCtrls, ExtCtrls, ComCtrls, Dialogs, Clipbrd,
  uAppContext, uConnections, uLdapEntry, uRtCheck;

resourcestring
  rsPwdTitle = 'Password tools';
  rsPwdEntry = 'Entry: %s';
  rsPwdNoEntry = 'No entry: local tools only.';
  rsPwdValues = 'Stored userPassword values';
  rsPwdValueCol = 'Value';
  rsPwdVerifyTab = 'Verify';
  rsPwdSetTab = 'Set';
  rsPwdModifyTab = 'Password Modify';
  rsPwdAdTab = 'Active Directory';
  rsPwdSecret = 'Password';
  rsPwdNewSecret = 'New password';
  rsPwdConfirm = 'Confirm';
  rsPwdOld = 'Current password';
  rsPwdVerify = 'Check stored values';
  rsPwdVerifyIntro = 'Check stored values: compares the password with the readable values above, offline. ' +
    'Nothing is sent to the network.';
  rsPwdTestIntro = 'Test bind: opens an independent connection to the same server and makes ONE bind with this ' +
    'entry''s DN. A failure can increase a lockout counter. The browsing session and the stored password are not changed.';
  rsPwdTestButton = 'Test bind on server';
  rsPwdTestAccepted = 'Accepted by the server at %s (%s).';
  rsPwdTestRefused = 'Refused: %s';
  rsPwdSetIntro = 'Computes the new value locally in the chosen format and writes it to userPassword; the server ' +
    'stores it as is, so it must support the format (see the note under the format). ' +
    '"Password Modify" lets the server apply its own policy and format instead.';
  rsPwdScheme = 'Format';
  rsPwdKeep = 'Keep the existing values (add the new one)';
  rsPwdSet = 'Set password...';
  rsPwdCompute = 'Compute only';
  rsPwdComputed = 'Computed value';
  rsPwdEmpty = 'Type the new password.';
  rsPwdNoTarget = 'No entry to write to: the value can only be computed.';
  rsPwdCopy = 'Copy (cleared after 30 s)';
  rsPwdModifyIntro = 'Uses the Password Modify operation (RFC 3062): the server applies its own policy and storage format.';
  rsPwdReset = 'Administrative reset';
  rsPwdChange = 'Change with current password';
  rsPwdRun = 'Send';
  rsPwdServerGenerated = 'Generated by server';
  rsPwdGeneratedByServer = 'The server generated the new password shown below. It is not stored.';
  rsPwdNotSupported = 'The server does not announce the Password Modify extended operation.';
  rsPwdEncryptedOnly = 'Password operations require an encrypted connection.';
  rsPwdNeedsServer = 'An LDIF file has no server to test a bind against: open the directory itself.';
  rsPwdMismatch = 'The two passwords differ.';
  rsPwdBusy = 'Too many password computations are running. Wait for them to finish.';
  rsPwdWriteInFlight = 'The previous change is still waiting for the server. Wait for its result.';
  rsPwdAdIntro = 'unicodePwd is never readable. Reset replaces it; change deletes the old value and adds the new one. ' +
    'The server enforces its policy and requires an encrypted connection.';
  rsPwdMustChange = 'User must change password at next logon (pwdLastSet = 0)';
  rsPwdNeverExpires = 'Password never expires (userAccountControl bit, other bits kept)';
  rsPwdCannotChange = '"User cannot change password" is a permission in the security descriptor, not a userAccountControl bit; it is not modified here.';
  rsPwdAdRun = 'Apply to Active Directory...';
  rsPwdDone = 'Done.';
  rsPwdValuesRereading = 'The entry changed with the last operation: reading it again. The values above are not ' +
