  rsPwdForNewEntry = 'New entry: the password is stored with the entry when it is created.';
  rsPwdSetIntroNew = 'Computes the stored value locally in the chosen format. It is sent with the new entry ' +
    'when you click Create, never before; the server stores it as is, so it must support the format ' +
    '(see the note under the format). The password itself is never kept.';
